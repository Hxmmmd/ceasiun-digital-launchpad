// Prisma ORM v7 schema for PostgreSQL

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  CEO
  ADMIN
  EMPLOYEE
  CLIENT
}

enum ContractStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
  EXPIRED
}

enum ServiceProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
}

model User {
  id              String      @id @default(uuid()) @db.Uuid
  fullName        String
  email           String      @unique
  passwordHash    String
  phoneNumber     String?
  role            UserRole    @default(CLIENT)
  isActive        Boolean     @default(true)
  emailVerifiedAt DateTime?   @db.Timestamptz(3)
  lastLoginAt     DateTime?   @db.Timestamptz(3)

  // Optional links: internal team users may not belong to a client.
  clientId        String?     @db.Uuid
  clientGroupId   String?     @db.Uuid
  client          Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientGroup     ClientGroup? @relation(fields: [clientGroupId], references: [id], onDelete: SetNull)

  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(3)

  @@index([clientId])
  @@index([clientGroupId])
  @@index([role, isActive])
}

model Client {
  id          String         @id @default(uuid()) @db.Uuid
  name        String
  companyName String?
  website     String?
  notes       String?        @db.Text

  users       User[]
  groups      ClientGroup[]
  contracts   ClientContract[]

  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)

  @@index([companyName])
}

model ClientGroup {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?  @db.Text
  clientId    String   @db.Uuid
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  users       User[]

  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  // A client cannot have two groups with the same name.
  @@unique([clientId, name])
  @@index([clientId])
}

model ClientContract {
  id              String          @id @default(uuid()) @db.Uuid
  title           String
  clientId        String          @db.Uuid
  client          Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)

  contractAmount  Decimal         @db.Decimal(12, 2)
  currency        String          @default("PKR") @db.VarChar(3)
  status          ContractStatus  @default(DRAFT)

  // Store the Google Drive share URL, not the PDF file itself.
  documentUrl     String?         @db.Text
  documentName    String?

  startsAt        DateTime?       @db.Timestamptz(3)
  endsAt          DateTime?       @db.Timestamptz(3)
  notes           String?         @db.Text

  services        ContractService[]

  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)

  @@index([clientId, status])
  @@index([startsAt, endsAt])
}

model Service {
  id               String            @id @default(uuid()) @db.Uuid
  name             String            @unique
  slug             String            @unique
  description      String?           @db.Text
  isActive          Boolean          @default(true)

  contractServices ContractService[]

  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
}

model ContractService {
  id              String                @id @default(uuid()) @db.Uuid
  contractId      String                @db.Uuid
  serviceId       String                @db.Uuid

  contract        ClientContract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  service         Service               @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  status          ServiceProgressStatus @default(NOT_STARTED)
  progressPercent Int                   @default(0)
  notes           String?               @db.Text
  startedAt       DateTime?             @db.Timestamptz(3)
  completedAt     DateTime?             @db.Timestamptz(3)

  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @db.Timestamptz(3)

  // The same service can appear in different contracts, but only once per contract.
  @@unique([contractId, serviceId])
  @@index([contractId, status])
  @@index([serviceId])
}
